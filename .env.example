# ===================================
# Local Model Configuration (app_local.py)
# ===================================

# Model Type Selection
# Options:
#   - deepseek-vl-1.3b: DeepSeek VL 1.3B (faster, 4GB VRAM, ~3GB download)
#   - deepseek-vl-7b: DeepSeek VL 7B (more accurate, 14GB VRAM, ~15GB download)
#   - minicpm-o-2.6: MiniCPM-o 2.6 (efficient, 8GB VRAM, ~8GB download)
#   - paddleocr: PaddleOCR (specialized table OCR, 2GB VRAM, auto-download)
MODEL_TYPE=deepseek-vl-1.3b

# Legacy: Direct HuggingFace model name (optional, overrides MODEL_TYPE)
# MODEL_NAME=deepseek-ai/deepseek-vl-1.3b-chat

# Device to run model on
# Options: auto, cuda, cpu
DEVICE=auto

# Memory optimization (set to true if you have limited GPU memory)
LOAD_IN_8BIT=false
LOAD_IN_4BIT=false

# ===================================
# API Configuration (app.py - original)
# ===================================
# Only needed if using the API version (app.py)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
