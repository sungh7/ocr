# ===================================
# Local Model Configuration (app_local.py)
# ===================================

# Model name from HuggingFace
# Options:
#   - deepseek-ai/deepseek-vl-1.3b-chat (smaller, faster, ~3GB)
#   - deepseek-ai/deepseek-vl-7b-chat (larger, more accurate, ~15GB)
MODEL_NAME=deepseek-ai/deepseek-vl-1.3b-chat

# Device to run model on
# Options: auto, cuda, cpu
DEVICE=auto

# Memory optimization (set to true if you have limited GPU memory)
LOAD_IN_8BIT=false
LOAD_IN_4BIT=false

# ===================================
# API Configuration (app.py - original)
# ===================================
# Only needed if using the API version (app.py)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
